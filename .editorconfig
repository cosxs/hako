root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

# the code blocks align their comments at a width of 4
[*.md]
indent_size = 4

# make needs tabs, and the OpenWrt SDK formats init scripts with shfmt, which
# indents with tabs
[{Makefile,*.init}]
indent_style = tab

# what migrate.uc writes through UCI, compared as it is
[tests/cases/migrate-*/expected*]
indent_style = tab
