'use strict';

import { readfile, writefile, unlink, access, popen, open, stat, lsdir, rename, mkdtemp, rmdir } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';
import * as socket from 'socket';

const PROFILE_DIR = '/etc/openbox/profiles';
const GENERATOR = '/usr/share/openbox/ucode/generate.uc';
const RUN_DIR = '/var/run/openbox';
const RUN_CONFIG = `${RUN_DIR}/config.json`;
const CORE = '/usr/bin/sing-box';
const CORE_INSTALL = '/usr/share/openbox/core-install.sh';
const CORE_UPLOAD = '/tmp/openbox-core-upload.apk';
const INSTALL_LOG = `${RUN_DIR}/core-install.log`;
const INSTALL_EXIT = `${RUN_DIR}/core-install.exit`;
const LOG_DIR = '/var/log/openbox';
const LOG_NAMES = [ 'app', 'core' ];
const LOG_BYTES = 256 * 1024;
// also safe to pass to the shell unquoted
const PROFILE_NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.json$/;

function command_output(cmd) {
	const proc = popen(cmd);
	if (!proc)
		return null;

	const out = proc.read('all');
	proc.close();

	return out;
}

// version >= 1.14, the oldest sing-box OpenBox supports
function version_supported(version) {
	const parts = map(split(version, '.'), (v) => +v);
	return parts[0] > 1 || (parts[0] == 1 && parts[1] >= 14);
}

function core_info() {
	if (!access(CORE, 'x'))
		return { installed: false };

	const out = command_output(`${CORE} version 2>/dev/null`) ?? '';
	const version = match(out, /sing-box version (\S+)/)?.[1];
	const tags = match(out, /Tags: (\S+)/)?.[1];

	return {
		installed: true,
		version: version,
		supported: version ? version_supported(version) : false,
		tags: tags ? split(tags, ',') : [],
		// the service of the sing-box package runs or starts at boot
		service_active: system('. /usr/share/openbox/common.sh; core_service_active') == 0
	};
}

function instance_pid() {
	const ubus = connect();
	const services = ubus.call('service', 'list', { name: 'openbox' });
	ubus.disconnect();

	for (let name, instance in services?.openbox?.instances ?? {})
		if (instance.running)
			return instance.pid;

	return null;
}

// seconds since the process started, from /proc/<pid>/stat field 22 (in USER_HZ ticks)
function process_uptime(pid) {
	const stat = readfile(`/proc/${pid}/stat`);
	const uptime = readfile('/proc/uptime');
	if (!stat || !uptime)
		return null;

	const fields = split(substr(stat, rindex(stat, ')') + 2), ' ');
	const started = +fields[19] / 100;

	return int(+split(uptime, ' ')[0] - started);
}

function load_json(path) {
	try {
		return json(readfile(path) ?? '');
	}
	catch (e) {
		return null;
	}
}

// the config sing-box would run: generated from UCI, or the selected raw JSON profile
function pending_config(source, profile) {
	if (source == 'profile')
		return profile ? load_json(`${PROFILE_DIR}/${profile}`) : null;

	try {
		return json(command_output(`ucode ${GENERATOR} 2>/dev/null`) ?? '');
	}
	catch (e) {
		return null;
	}
}

// how traffic is taken over, derived from the inbounds of the profile
function takeover(config) {
	const result = { tun: null, tproxy: null, redirect: null, dns: null, mixed: null };

	for (let inbound in config?.inbounds ?? []) {
		switch (inbound.type) {
		case 'tun':
			if (!result.tun)
				result.tun = inbound.tag ?? inbound.type;

			// sing-box hijacks DNS itself when it sets up the routes
			if (inbound.auto_route && inbound.dns_mode != 'disabled' && !result.dns)
				result.dns = { tag: inbound.tag ?? inbound.type };
			break;

		case 'tproxy':
		case 'redirect':
			if (!result[inbound.type])
				result[inbound.type] = inbound.tag ?? inbound.type;
			break;

		// a proxy port for devices set up by hand, beside the takeover
		case 'mixed':
			if (!result.mixed)
				result.mixed = { tag: inbound.tag ?? inbound.type, port: inbound.listen_port };
			break;

		case 'direct':
			if (inbound.tag == 'dns-in')
				result.dns = { tag: inbound.tag, port: inbound.listen_port };
			break;
		}
	}

	return result;
}

function clash_api(config) {
	const api = config?.experimental?.clash_api;
	if (!api?.external_controller)
		return null;

	const controller = api.external_controller;
	const host = substr(controller, 0, rindex(controller, ':'));

	return {
		host: host,
		port: +substr(controller, rindex(controller, ':') + 1),
		secret: api.secret,
		default_mode: api.default_mode ?? 'Rule'
	};
}

// a minimal HTTP/1.0 client for the clash API of the running sing-box
function clash_request(api, method, path, body) {
	let host = replace(api.host, /^\[|\]$/g, '');
	if (host in [ '', '0.0.0.0', '::' ])
		host = '127.0.0.1';

	const sock = socket.connect(host, `${api.port}`, null, 3000);
	if (!sock)
		return null;

	let req = `${method} ${path} HTTP/1.0\r\nHost: ${host}\r\n`;
	if (api.secret)
		req += `Authorization: Bearer ${api.secret}\r\n`;
	if (body != null)
		req += `Content-Type: application/json\r\nContent-Length: ${length(body)}\r\n`;

	sock.send(`${req}\r\n${body ?? ''}`);

	let resp = '', chunk;
	while ((chunk = sock.recv(4096)) != null && length(chunk) > 0)
		resp += chunk;

	sock.close();

	const status = +match(resp, /^HTTP\/1\.\d (\d+)/)?.[1];
	const content = substr(resp, index(resp, '\r\n\r\n') + 4);
	let data = null;

	try {
		data = length(content) ? json(content) : null;
	}
	catch (e) {}

	return { status: status, data: data };
}

// the clash API of the running sing-box, or why it is not available
function running_clash_api() {
	if (!instance_pid())
		return { error: 'not_running' };

	const api = clash_api(load_json(RUN_CONFIG));
	if (!api)
		return { error: 'no_clash_api' };

	return { api: api };
}

function clash_mode(api) {
	const resp = clash_request(api, 'GET', '/configs');
	if (resp?.status != 200)
		return null;

	return { mode: resp.data?.mode, modes: resp.data?.['mode-list'] ?? [] };
}

// percent-encode a path segment, for group and outbound names
function escape_path(value) {
	return join('', map(split(value, ''), (c) => match(c, /^[A-Za-z0-9._~-]$/) ? c : sprintf('%%%02X', ord(c))));
}

// the outbound modes a config offers: its default mode and those of the
// rules, which sing-box matches regardless of case
function config_modes(config, api) {
	const modes = [ api.default_mode ];

	for (let rule in [ ...(config?.route?.rules ?? []), ...(config?.dns?.rules ?? []) ])
		if (type(rule.clash_mode) == 'string' && !length(filter(modes, (m) => lc(m) == lc(rule.clash_mode))))
			push(modes, rule.clash_mode);

	return modes;
}

function profile_path(name) {
	return (type(name) == 'string' && match(name, PROFILE_NAME)) ? `${PROFILE_DIR}/${name}` : null;
}

function profile_in_use(name) {
	const uci = cursor();
	return uci.get('openbox', 'main', 'source') == 'profile' && uci.get('openbox', 'main', 'profile') == name;
}

// a directory of its own for the files of one call, so calls at the same
// time never read each other's; removed with its files by remove_temp()
function make_temp() {
	system(`mkdir -p ${RUN_DIR}`);
	return mkdtemp(`${RUN_DIR}/check-XXXXXX`);
}

function remove_temp(dir) {
	for (let name in lsdir(dir) ?? [])
		unlink(`${dir}/${name}`);
	rmdir(dir);
}

// sing-box check on a config file, with what it printed but without the
// colors of its log; passes when sing-box is not installed yet. The log goes
// into dir when given (left to the caller), else into a directory of its own
function check_config(path, dir) {
	if (!access(CORE, 'x'))
		return { result: true, output: '' };

	const temp = dir ?? make_temp();
	if (!temp)
		return { result: false, output: 'cannot create a temporary file' };

	const passed = system(`${CORE} check -c ${path} -D ${RUN_DIR} > ${temp}/check.log 2>&1`) == 0;
	const output = replace(readfile(`${temp}/check.log`) ?? '', regexp('\x1b\\[[0-9;]*m', 'g'), '');
	if (!dir)
		remove_temp(temp);

	return { result: passed, output: trim(output) };
}

// checks a config given as text, as it would be saved
function check_content(content) {
	try {
		json(content);
	}
	catch (e) {
		return { result: false, error: 'invalid_json', output: `${e}` };
	}

	const temp = make_temp();
	if (!temp)
		return { result: false, error: 'check_failed', output: 'cannot create a temporary file' };

	writefile(`${temp}/check.json`, content);
	const check = check_config(`${temp}/check.json`, temp);
	remove_temp(temp);

	if (!check.result)
		check.error = 'check_failed';

	return check;
}

function reload_running() {
	return instance_pid() != null && system('/etc/init.d/openbox reload >/dev/null 2>&1') == 0;
}

function install_running() {
	return access(INSTALL_LOG) && !access(INSTALL_EXIT);
}

const methods = {
	status: {
		call: function() {
			const uci = cursor();
			const source = uci.get('openbox', 'main', 'source') == 'profile' ? 'profile' : 'model';
			const profile = uci.get('openbox', 'main', 'profile') || null;
			const pid = instance_pid();
			const config = pid ? load_json(RUN_CONFIG) : pending_config(source, profile);
			const api = clash_api(config);

			return {
				enabled: uci.get('openbox', 'main', 'enabled') == '1',
				running: pid != null,
				uptime: pid ? process_uptime(pid) : null,
				source: source,
				profile: profile,
				version: trim(readfile('/usr/share/openbox/version') ?? '') || null,
				core: core_info(),
				takeover: takeover(config),
				clash_api: api ? {
					mode: (pid ? clash_mode(api)?.mode : null) ?? api.default_mode
				} : null
			};
		}
	},

	control: {
		args: { action: 'action' },
		call: function(req) {
			const action = req.args?.action;

			// takeover: stop and disable the service of the sing-box package,
			// then enable and start OpenBox as below
			if (action == 'takeover')
				system('/etc/init.d/openbox takeover_core >/dev/null 2>&1');

			// enable: turn the service on in UCI, then start it
			if (action in [ 'enable', 'takeover' ]) {
				const uci = cursor();
				uci.set('openbox', 'main', 'enabled', '1');
				uci.commit('openbox');

				return { result: system('/etc/init.d/openbox start >/dev/null 2>&1') == 0 };
			}

			if (!(action in [ 'start', 'stop', 'restart', 'reload' ]))
				return { result: false, error: 'invalid action' };

			return { result: system(`/etc/init.d/openbox ${action} >/dev/null 2>&1`) == 0 };
		}
	},

	// the outbound modes of the config OpenBox runs, the one chosen in
	// main.mode (set on sing-box when the settings are applied), and the one
	// sing-box runs with
	mode: {
		call: function() {
			const uci = cursor();
			const source = uci.get('openbox', 'main', 'source') == 'profile' ? 'profile' : 'model';
			const config = pending_config(source, uci.get('openbox', 'main', 'profile'));
			const api = clash_api(config);
			if (!api)
				return { available: false, reason: 'no_clash_api' };

			const running = running_clash_api();

			return {
				available: true,
				modes: config_modes(config, api),
				default: api.default_mode,
				mode: uci.get('openbox', 'main', 'mode') ?? null,
				running: running.api ? clash_mode(running.api)?.mode : null
			};
		}
	},

	// the outbounds of the running sing-box: their names, the groups with
	// their current outbound, and the last measured delay of each
	outbounds: {
		call: function() {
			const running = running_clash_api();
			if (running.error)
				return { available: false, reason: running.error };

			const resp = clash_request(running.api, 'GET', '/proxies');
			if (resp?.status != 200)
				return { available: false, reason: 'unreachable' };

			const names = [], groups = {}, delays = {};

			for (let name, proxy in resp.data?.proxies ?? {}) {
				// GLOBAL is added by the clash API itself
				if (name == 'GLOBAL')
					continue;

				const history = proxy.history ?? [];
				const delay = length(history) ? history[length(history) - 1].delay : 0;

				push(names, name);

				if (delay > 0)
					delays[name] = delay;

				if (type(proxy.all) == 'array')
					groups[name] = { type: lc(proxy.type), now: proxy.now, all: proxy.all };
			}

			return { available: true, names: names, groups: groups, delays: delays };
		}
	},

	// switch the outbound of a selector group
	select: {
		args: { group: 'group', outbound: 'outbound' },
		call: function(req) {
			const running = running_clash_api();
			if (running.error)
				return { result: false, error: running.error };

			const group = req.args?.group, outbound = req.args?.outbound;
			if (!group || !outbound)
				return { result: false, error: 'invalid arguments' };

			const resp = clash_request(running.api, 'PUT', `/proxies/${escape_path(group)}`,
				sprintf('%J', { name: outbound }));

			return { result: resp?.status == 204 };
		}
	},

	log_read: {
		args: { name: 'name', offset: 0 },
		call: function(req) {
			const name = req.args?.name;
			if (!(name in LOG_NAMES))
				return { error: 'invalid log' };

			const path = `${LOG_DIR}/${name}.log`;
			const size = stat(path)?.size ?? 0;

			// a log smaller than the offset was rotated or emptied: start over
			let offset = +(req.args?.offset ?? 0);
			if (offset > size)
				offset = 0;

			const start = (size - offset > LOG_BYTES) ? size - LOG_BYTES : offset;
			let content = '';

			if (size > start) {
				const file = open(path);
				if (file) {
					file.seek(start);
					content = file.read('all') ?? '';
					file.close();
				}

				// skip the partial first line when starting mid-file
				if (start > offset)
					content = substr(content, index(content, '\n') + 1);
			}

			return { content: content, size: size };
		}
	},

	// the latest GitHub release for this device
	core_latest: {
		call: function() {
			const out = trim(command_output(`${CORE_INSTALL} latest 2>&1`) ?? '');

			try {
				return json(out);
			}
			catch (e) {
				return { error: out };
			}
		}
	},

	// installs the core from the latest GitHub release or the uploaded apk in the
	// background; progress is read with core_install_status
	core_install: {
		args: { source: 'source' },
		call: function(req) {
			const source = req.args?.source;
			let cmd;

			if (source == 'github')
				cmd = `${CORE_INSTALL} github`;
			else if (source == 'upload')
				cmd = `${CORE_INSTALL} upload ${CORE_UPLOAD}`;
			else
				return { result: false, error: 'invalid source' };

			if (install_running())
				return { result: false, error: 'busy' };

			system(`mkdir -p ${RUN_DIR}`);
			unlink(INSTALL_EXIT);
			writefile(INSTALL_LOG, '');
			system(`( ${cmd} >> ${INSTALL_LOG} 2>&1; echo $? > ${INSTALL_EXIT} ) </dev/null >/dev/null 2>&1 &`);

			return { result: true };
		}
	},

	// the native JSON profiles, and which config is in use
	profiles: {
		call: function() {
			const uci = cursor();
			const profiles = [];

			for (let name in lsdir(PROFILE_DIR) ?? []) {
				const info = stat(`${PROFILE_DIR}/${name}`);
				if (info?.type == 'file' && match(name, PROFILE_NAME))
					push(profiles, { name: name, size: info.size, mtime: info.mtime });
			}

			return {
				source: uci.get('openbox', 'main', 'source') == 'profile' ? 'profile' : 'model',
				profile: uci.get('openbox', 'main', 'profile') || null,
				profiles: sort(profiles, (a, b) => (a.name < b.name) ? -1 : 1)
			};
		}
	},

	profile_read: {
		args: { name: 'name' },
		call: function(req) {
			const path = profile_path(req.args?.name);
			const content = path ? readfile(path) : null;

			return (content != null) ? { content: content } : { error: 'not_found' };
		}
	},

	// the config OpenBox generates from its settings, with the warnings of
	// the generator about what it skipped
	generated: {
		call: function() {
			const temp = make_temp();
			if (!temp)
				return { error: 'generate_failed', warnings: 'cannot create a temporary file' };

			const content = command_output(`ucode ${GENERATOR} 2> ${temp}/generate.log`);
			const warnings = trim(readfile(`${temp}/generate.log`) ?? '');
			remove_temp(temp);

			return content ? { content: content, warnings: warnings } : { error: 'generate_failed', warnings: warnings };
		}
	},

	profile_check: {
		args: { content: 'content' },
		call: function(req) {
			return check_content(req.args?.content);
		}
	},

	// the profile in use is only saved when it passes the check, and then
	// sing-box runs it right away
	profile_save: {
		args: { name: 'name', content: 'content' },
		call: function(req) {
			const name = req.args?.name;
			const path = profile_path(name);
			const content = req.args?.content;
			if (!path || type(content) != 'string')
				return { result: false, error: 'invalid_name' };

			const in_use = profile_in_use(name);
			const check = in_use ? check_content(content) : null;

			if (!in_use) {
				try {
					json(content);
				}
				catch (e) {
					return { result: false, error: 'invalid_json', output: `${e}` };
				}
			}
			else if (!check.result) {
				return check;
			}

			system(`mkdir -p ${PROFILE_DIR}`);
			if (!writefile(`${path}.tmp`, content) || !rename(`${path}.tmp`, path))
				return { result: false, error: 'write_failed' };

			return { result: true, reloaded: in_use ? reload_running() : false };
		}
	},

	profile_delete: {
		args: { name: 'name' },
		call: function(req) {
			const path = profile_path(req.args?.name);
			if (!path)
				return { result: false, error: 'invalid_name' };

			if (profile_in_use(req.args.name))
				return { result: false, error: 'in_use' };

			return { result: unlink(path) == true };
		}
	},

	// switches to a profile, or without a name to the generated config; it
	// must pass the check, and a running service is reloaded with it
	profile_use: {
		args: { name: 'name' },
		call: function(req) {
			const name = req.args?.name || null;
			let path, temp;

			if (name) {
				path = profile_path(name);
				if (!path || !access(path))
					return { result: false, error: 'not_found' };
			}
			else {
				temp = make_temp();
				path = `${temp}/check.json`;
				if (!temp || system(`ucode ${GENERATOR} > ${path} 2>/dev/null`) != 0) {
					if (temp)
						remove_temp(temp);
					return { result: false, error: 'generate_failed' };
				}
			}

			const check = check_config(path, temp);
			if (temp)
				remove_temp(temp);

			if (!check.result) {
				check.error = 'check_failed';
				return check;
			}

			const uci = cursor();
			uci.set('openbox', 'main', 'source', name ? 'profile' : 'model');
			if (name)
				uci.set('openbox', 'main', 'profile', name);
			uci.commit('openbox');

			return { result: true, reloaded: reload_running() };
		}
	},

	core_install_status: {
		call: function() {
			const exit = readfile(INSTALL_EXIT);
			const log = readfile(INSTALL_LOG) ?? '';
			const lines = split(trim(log), '\n');

			return {
				running: install_running(),
				success: exit != null ? +trim(exit) == 0 : null,
				log: join('\n', slice(lines, -30))
			};
		}
	}
};

return { 'luci.openbox': methods };
