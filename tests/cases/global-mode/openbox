config openbox 'main'
	option config_version '1'
	option enabled '0'
	option profile 'default'
	option mode 'Global'

config openbox 'logs'
	option auto_clean '1'
	option retention_days '7'

config experimental 'clash_api'
	option external_controller '127.0.0.1:9090'
	option secret ''
	option default_mode 'Rule'

config experimental 'cache_file'
	option enabled '1'
	option path '/etc/openbox/cache.db'
	option store_fakeip '1'

config inbound 'tun'
	option enabled '1'
	option type 'tun'
	option tag 'tun-in'
	option interface_name 'openbox-tun'
	list address '172.19.0.1/30'
	option auto_route '1'
	option auto_redirect '1'
	list route_exclude_address '0.0.0.0/8'
	list route_exclude_address '10.0.0.0/8'
	list route_exclude_address '100.64.0.0/10'
	list route_exclude_address '127.0.0.0/8'
	list route_exclude_address '169.254.0.0/16'
	list route_exclude_address '172.16.0.0/12'
	list route_exclude_address '192.0.0.0/24'
	list route_exclude_address '192.168.0.0/16'
	list route_exclude_address '224.0.0.0/4'
	list route_exclude_address '240.0.0.0/4'
	list route_exclude_address '::1/128'
	list route_exclude_address 'fd00::/8'
	list route_exclude_address 'fe80::/10'
	list route_exclude_address 'ff00::/8'
	list route_exclude_address_set 'cn_ip'

config inbound 'tproxy'
	option enabled '0'
	option type 'tproxy'
	option tag 'tproxy-in'
	option listen '::'
	option listen_port '7893'

config inbound 'dns_in'
	option enabled '1'
	option type 'direct'
	option tag 'dns-in'
	option listen '::'
	option listen_port '1053'

config inbound 'mixed'
	option enabled '0'
	option type 'mixed'
	option tag 'mixed-in'
	option listen '::'
	option listen_port '7890'

config openbox 'firewall'
	option ipv6 '0'
	list interface 'lan'
	list bypass_address '0.0.0.0/8'
	list bypass_address '10.0.0.0/8'
	list bypass_address '100.64.0.0/10'
	list bypass_address '127.0.0.0/8'
	list bypass_address '169.254.0.0/16'
	list bypass_address '172.16.0.0/12'
	list bypass_address '192.0.0.0/24'
	list bypass_address '192.168.0.0/16'
	list bypass_address '224.0.0.0/4'
	list bypass_address '240.0.0.0/4'
	list bypass_address6 '::1/128'
	list bypass_address6 'fd00::/8'
	list bypass_address6 'fe80::/10'
	list bypass_address6 'ff00::/8'
	list bypass_rule_set 'cn_ip'
	option mark '0x6f62'
	option output_mark '0x6f63'
	option route_table '233'
	option rule_priority '1100'
