config log 'log'
  option level 'warn'
  option timestamp '1'

config dns 'dns'
  option final 'remote'
  option strategy 'ipv4_only'
  option optimistic '1'

config dns_server 'local'
  option tag 'local'
  option type 'local'

config dns_server 'alidns'
  option tag 'alidns'
  option type 'udp'
  option server '223.5.5.5'

config dns_server 'fakeip'
  option tag 'fakeip'
  option type 'fakeip'
  option inet4_range '198.18.0.0/15'
  option inet6_range '2001:2::/48'

config dns_server 'remote'
  option tag 'remote'
  option type 'https'
  option server '1.1.1.1'
  option detour 'proxy'

config dns_rule
  list domain_suffix 'lan'
  list domain_suffix '10.in-addr.arpa'
  list domain_suffix '168.192.in-addr.arpa'
  list domain_regex '\.(1[6-9]|2[0-9]|3[01])\.172\.in-addr\.arpa$'
  option server 'local'

config dns_rule
  option action 'evaluate'
  option server 'alidns'
  option timeout '2s'

config dns_rule
  option match_response '1'
  list rule_set 'cn_ip'
  option action 'respond'

config dns_rule 'foreign'
  option match_response '1'
  option response_rcode 'NOERROR'
  option ip_accept_any '1'
  list query_type 'A'
  list query_type 'AAAA'
  option server 'fakeip'
  option rewrite_ttl '1'

config dns_rule
  option match_response '1'
  option response_rcode 'NOERROR'
  option action 'respond'

config dns_rule
  option match_response '1'
  option response_rcode 'NXDOMAIN'
  option action 'respond'

config dns_rule 'fallback'
  list query_type 'A'
  list query_type 'AAAA'
  option server 'fakeip'
  option rewrite_ttl '1'

config ntp 'ntp'
  option enabled '0'
  option server 'ntp.aliyun.com'
  option server_port '123'
  option interval '30m'

config route 'route'
  option final 'proxy'
  option default_domain_resolver 'alidns'
  option auto_detect_interface '1'
  option find_neighbor '1'

config rule_set 'cn_ip'
  option tag 'cn-mainland-ip'
  option type 'local'
  option format 'binary'
  option path '/usr/share/openbox/rule-set/cn-mainland-ip.srs'

# a remote rule set without an http client: one is added through route.final;
# the one it names is gone, so it falls back to it with a warning
config rule_set 'geosite_cn'
  option tag 'geosite-cn'
  option type 'remote'
  option format 'binary'
  option url 'https://example.com/geosite-cn.srs'
  option http_client 'gone'

config outbound 'direct'
  option tag 'Direct'
  option type 'direct'
  option hidden '1'

config outbound 'proxy'
  option tag 'Proxy'
  option type 'selector'
  list outbounds 'auto'
  list outbounds 'node_hk'
  list outbounds 'node_us'
  list outbounds 'direct'

config outbound 'global'
  option tag 'Global'
  option type 'selector'
  option hidden '1'

config route_rule
  option action 'sniff'
  option hidden '1'

config route_rule
  list protocol 'dns'
  option action 'hijack-dns'
  option hidden '1'

config route_rule
  option ip_is_private '1'
  option outbound 'direct'
  option hidden '1'

config route_rule
  option clash_mode 'Direct'
  option outbound 'direct'
  option hidden '1'

config route_rule
  option clash_mode 'Global'
  option outbound 'global'
  option hidden '1'

config route_rule
  list port '853'
  option action 'reject'

config route_rule
  list protocol 'quic'
  option action 'reject'

config route_rule
  list rule_set 'cn_ip'
  option outbound 'direct'

config outbound 'node_hk'
  option tag 'HK 01'
  option type 'shadowsocks'
  option server '192.0.2.1'
  option server_port '8388'
  option method 'aes-128-gcm'
  option password 'placeholder-password'

config outbound 'node_us'
  option tag 'US 01'
  option type 'vmess'
  option server 'node.example.com'
  option server_port '443'
  option uuid '00000000-0000-0000-0000-000000000000'
  option security 'auto'
  option tls_enabled '1'
  option tls_server_name 'node.example.com'
  option transport_type 'ws'
  option transport_path '/placeholder'
  list transport_headers 'Host: node.example.com'

config outbound 'auto'
  option tag 'Auto'
  option type 'urltest'
  list outbounds 'node_hk'
  option url 'https://www.gstatic.com/generate_204'
  option interval '3m'
  option tolerance '50'

config outbound 'auto_us'
  option tag 'Auto US'
  option type 'urltest'
  list outbounds 'node_us'

# a logical rule: a device and a domain, one of them an or of two written
# as JSON, and not the mainland addresses of a rule set named by its section
config route_rule
  option type 'logical'
  option id 'netflix'
  option mode 'and'
  option outbound 'auto'

config route_subrule
  option rule 'netflix'
  list source_ip_cidr '192.168.1.50/32'

config route_subrule
  option rule 'netflix'
  option json '{"type": "logical", "mode": "or", "rules": [{"domain_suffix": ["netflix.com"]}, {"domain_keyword": ["nflx"]}]}'

config route_subrule
  option rule 'netflix'
  list rule_set 'cn_ip'
  option invert '1'

# a logical rule without rules is skipped with a warning
config route_rule
  option type 'logical'
  option id 'empty'
  option mode 'or'
  option outbound 'auto'
