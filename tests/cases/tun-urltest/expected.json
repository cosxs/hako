{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "final": "remote",
    "strategy": "ipv4_only",
    "optimistic": true,
    "servers": [
      {
        "type": "local",
        "tag": "local"
      },
      {
        "type": "udp",
        "tag": "alidns",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "2001:2::/48"
      },
      {
        "type": "https",
        "tag": "remote",
        "detour": "Proxy",
        "server": "1.1.1.1"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "lan",
          "10.in-addr.arpa",
          "168.192.in-addr.arpa"
        ],
        "domain_regex": [
          "\\.(1[6-9]|2[0-9]|3[01])\\.172\\.in-addr\\.arpa$"
        ],
        "server": "local"
      },
      {
        "action": "evaluate",
        "server": "alidns",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": [
          "geoip-cn"
        ],
        "action": "respond"
      },
      {
        "match_response": true,
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      },
      {
        "match_response": true,
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": true,
        "response_rcode": "NXDOMAIN",
        "action": "respond"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ]
  },
  "ntp": {
    "enabled": false,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "hako-tun",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "auto_redirect": true,
      "route_exclude_address": [
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.168.0.0/16",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "::1/128",
        "fd00::/8",
        "fe80::/10",
        "ff00::/8"
      ],
      "route_exclude_address_set": [
        "geoip-cn"
      ]
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 1053
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "Direct"
    },
    {
      "type": "shadowsocks",
      "tag": "HK 01",
      "server": "192.0.2.1",
      "server_port": 8388,
      "method": "aes-128-gcm",
      "password": "placeholder-password"
    },
    {
      "type": "vmess",
      "tag": "US 01",
      "server": "node.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "security": "auto",
      "tls": {
        "enabled": true,
        "server_name": "node.example.com"
      },
      "transport": {
        "type": "ws",
        "path": "/placeholder",
        "headers": {
          "Host": "node.example.com"
        }
      }
    },
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "Auto",
        "HK 01",
        "US 01",
        "Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "Global",
      "outbounds": [
        "HK 01",
        "US 01",
        "Direct",
        "Proxy",
        "Auto",
        "Auto US"
      ]
    },
    {
      "type": "urltest",
      "tag": "Auto",
      "outbounds": [
        "HK 01"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "Auto US",
      "outbounds": [
        "US 01"
      ],
      "url": "https://cp.cloudflare.com/generate_204"
    }
  ],
  "http_clients": [
    {
      "tag": "Default",
      "detour": "Proxy"
    }
  ],
  "route": {
    "final": "Proxy",
    "default_domain_resolver": "alidns",
    "find_neighbor": true,
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "Direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "Global"
      },
      {
        "port": [
          853
        ],
        "action": "reject"
      },
      {
        "protocol": [
          "quic"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "outbound": "Direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "outbound": "Auto",
        "rules": [
          {
            "source_ip_cidr": [
              "192.168.1.50/32"
            ]
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "domain_suffix": [
                  "netflix.com"
                ]
              },
              {
                "domain_keyword": [
                  "nflx"
                ]
              }
            ]
          },
          {
            "rule_set": [
              "geoip-cn"
            ],
            "invert": true
          }
        ]
      }
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "update_interval": "24h",
        "initial_path": "/usr/share/hako/rule-set/geoip-cn.srs"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://example.com/geosite-cn.srs"
      }
    ]
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "path": "/etc/hako/cache.db",
      "store_fakeip": true
    }
  }
}
