config log 'log'
  option level 'warn'
  option timestamp '1'

config dns 'dns'
  option final 'remote'
  option strategy 'ipv4_only'
  option optimistic '1'

config dns_server 'local'
  option tag 'local'
  option type 'local'

config dns_server 'alidns'
  option tag 'alidns'
  option type 'udp'
  option server '223.5.5.5'

config dns_server 'fakeip'
  option tag 'fakeip'
  option type 'fakeip'
  option inet4_range '198.18.0.0/15'
  option inet6_range '2001:2::/48'

config dns_server 'remote'
  option tag 'remote'
  option type 'https'
  option server '1.1.1.1'
  option detour 'proxy'

config dns_rule
  list domain_suffix 'lan'
  list domain_suffix '10.in-addr.arpa'
  list domain_suffix '168.192.in-addr.arpa'
  list domain_regex '\.(1[6-9]|2[0-9]|3[01])\.172\.in-addr\.arpa$'
  option server 'local'

config dns_rule
  option action 'evaluate'
  option server 'alidns'
  option timeout '2s'

config dns_rule
  option match_response '1'
  list rule_set 'cn_ip'
  option action 'respond'

config dns_rule 'foreign'
  option match_response '1'
  option response_rcode 'NOERROR'
  option ip_accept_any '1'
  list query_type 'A'
  list query_type 'AAAA'
  option server 'fakeip'
  option rewrite_ttl '1'

config dns_rule
  option match_response '1'
  option response_rcode 'NOERROR'
  option action 'respond'

config dns_rule
  option match_response '1'
  option response_rcode 'NXDOMAIN'
  option action 'respond'

config dns_rule 'fallback'
  list query_type 'A'
  list query_type 'AAAA'
  option server 'fakeip'
  option rewrite_ttl '1'

config ntp 'ntp'
  option enabled '0'
  option server 'ntp.aliyun.com'
  option server_port '123'
  option interval '30m'

config route 'route'
  option final 'proxy'
  option default_domain_resolver 'alidns'
  option auto_detect_interface '1'
  option find_neighbor '1'

config rule_set 'cn_ip'
  option tag 'cn-mainland-ip'
  option type 'local'
  option format 'binary'
  option path '/usr/share/openbox/rule-set/cn-mainland-ip.srs'

config outbound 'direct'
  option tag 'Direct'
  option type 'direct'
  option hidden '1'

config outbound 'proxy'
  option tag 'Proxy'
  option type 'selector'
  list outbounds 'vless_ws'
  list outbounds 'trojan_http'
  list outbounds 'vmess_hu'
  list outbounds 'naive_tls'
  list outbounds 'ss_obfs'
  list outbounds 'hy2_gecko'
  list outbounds 'hy2_realm'
  list outbounds 'tuic_stream'
  list outbounds 'anytls_node'
  list outbounds 'snell4'
  list outbounds 'snell6'
  list outbounds 'ssh_node'
  list outbounds 'http_proxy'
  list outbounds 'direct'

config outbound 'global'
  option tag 'Global'
  option type 'selector'
  option hidden '1'

config route_rule
  option action 'sniff'
  option hidden '1'

config route_rule
  list protocol 'dns'
  option action 'hijack-dns'
  option hidden '1'

config route_rule
  option ip_is_private '1'
  option outbound 'direct'
  option hidden '1'

config route_rule
  option clash_mode 'Direct'
  option outbound 'direct'
  option hidden '1'

config route_rule
  option clash_mode 'Global'
  option outbound 'global'
  option hidden '1'

config route_rule
  list port '853'
  option action 'reject'

config route_rule
  list protocol 'quic'
  option action 'reject'

config route_rule
  list rule_set 'cn_ip'
  option outbound 'direct'

config outbound 'vless_ws'
  option tag 'VLESS WS'
  option type 'vless'
  option network 'tcp'
  option server 'example.com'
  option server_port '443'
  option uuid '00000000-0000-0000-0000-000000000000'
  option packet_encoding 'xudp'
  option tls_enabled '1'
  option tls_server_name 'www.example.com'
  option tls_fields '{"server_name":"override.example.com","min_version":"1.2","ech":{"enabled":true}}'
  option transport_type 'ws'
  option transport_path '/ws'
  list transport_headers 'User-Agent: Mozilla/5.0'
  list transport_headers 'Host: cdn.example.com'
  option dial_fields '{"connect_timeout":"10s","tcp_fast_open":true,"domain_resolver":"alidns"}'
  option multiplex_enabled '1'
  option multiplex_protocol 'smux'
  option multiplex_max_connections '4'
  option multiplex_min_streams '4'
  option multiplex_padding '1'
  option multiplex_brutal_enabled '1'
  option multiplex_brutal_up_mbps '100'
  option multiplex_brutal_down_mbps '200'

config outbound 'trojan_http'
  option tag 'Trojan HTTP'
  option type 'trojan'
  option network 'tcp'
  option server '192.0.2.1'
  option server_port '443'
  option password 'placeholder-password'
  option tls_enabled '1'
  option tls_server_name 'example.com'
  option tls_fields '["not an object"]'
  option multiplex_enabled '1'
  option multiplex_max_streams '8'
  option dial_fields '{"detour":"Hysteria2 gecko","bind_interface":"eth0","tcp_keep_alive":"5m"}'
  option transport_type 'http'
  option transport_path '/h'
  list transport_host 'a.example.com'
  list transport_host 'b.example.com'
  option transport_method 'GET'
  list transport_headers 'Accept: text/html'
  list transport_headers 'Accept: */*'
  list transport_headers 'X-Note:  spaced value '

config outbound 'vmess_hu'
  option tag 'VMess HTTPUpgrade'
  option type 'vmess'
  option tls_fields '{"server_name":"ignored.example.com"}'
  option global_padding '1'
  option authenticated_length '1'
  option server '192.0.2.4'
  option server_port '80'
  option uuid '00000000-0000-0000-0000-000000000000'
  option transport_type 'httpupgrade'
  option transport_path '/up'
  list transport_host 'hu.example.com'
  list transport_headers 'User-Agent: Mozilla/5.0'
  list transport_headers 'bad header'

config outbound 'naive_tls'
  option tag 'Naive TLS'
  option type 'naive'
  option server '192.0.2.5'
  option server_port '443'
  option username 'user'
  option password 'placeholder-password'
  option insecure_concurrency '2'
  list extra_headers 'X-Test: a'
  list extra_headers 'X-Test: b'
  option stream_receive_window '6MB'
  option udp_over_tcp '1'
  option quic '1'
  option quic_congestion_control 'bbr2'
  option quic_session_receive_window '15728640'
  option tls_server_name 'example.com'
  option tls_fields '{"server_name":"naive.example.com"}'

config outbound 'ss_obfs'
  option tag 'SS obfs'
  option type 'shadowsocks'
  option network 'udp'
  option server '192.0.2.2'
  option server_port '8388'
  option method 'aes-128-gcm'
  option password 'placeholder-password'
  option plugin 'obfs-local'
  option plugin_opts 'obfs=http;obfs-host=example.com'
  option udp_over_tcp '1'

config outbound 'hy2_gecko'
  option tag 'Hysteria2 gecko'
  option type 'hysteria2'
  option network 'udp'
  option server '192.0.2.3'
  option server_port '443'
  list server_ports '20000:30000'
  option hop_interval '30s'
  option password 'placeholder-password'
  option hop_interval_max '60s'
  option obfs_type 'gecko'
  option obfs_password 'placeholder-password'
  option obfs_min_packet_size '512'
  option obfs_max_packet_size '1200'
  option bbr_profile 'aggressive'
  option brutal_debug '1'
  option disable_chrome_parrot '1'
  option initial_packet_size '1200'
  option disable_path_mtu_discovery '1'
  option idle_timeout '30s'
  option keep_alive_period '10s'
  option stream_receive_window '64 MB'
  option connection_receive_window '67108864'
  option max_concurrent_streams '100'
  option tls_server_name 'example.com'

config http_client 'realm_client'
  option tag 'Realm client'
  option version '3'
  option disable_version_fallback '1'
  list headers 'User-Agent: openbox'
  list headers 'Accept: */*'
  option initial_packet_size '1252'
  option disable_path_mtu_discovery '1'
  option idle_timeout '30s'
  option max_concurrent_streams '100'
  option tls_fields '{"server_name": "realm.example.com", "insecure": true}'
  option dial_fields '{"detour": "VLESS WS", "connect_timeout": "5s"}'

# version 2, the default: the HTTP2 fields, not those of QUIC
config http_client 'h2_client'
  option tag 'HTTP2 client'
  option initial_packet_size '1252'
  option keep_alive_period '15s'
  option stream_receive_window '6MB'
  option connection_receive_window '15MB'

config outbound 'hy2_realm'
  option tag 'Hysteria2 realm'
  option type 'hysteria2'
  option password 'placeholder-password'
  option realm_server_url 'https://realm.example.com'
  option realm_token 'placeholder-token'
  option realm_realm_id 'node-a'
  list realm_stun_servers 'stun.example.com:3478'
  option realm_ip_version '4'
  option realm_port_mapping_enabled '1'
  option realm_port_mapping_timeout '10s'
  option realm_port_mapping_lifetime '10m'
  option realm_http_client 'realm_client'
  option tls_server_name 'example.com'

config outbound 'tuic_stream'
  option tag 'TUIC stream'
  option type 'tuic'
  option server '192.0.2.7'
  option server_port '443'
  option uuid '00000000-0000-0000-0000-000000000000'
  option password 'placeholder-password'
  option udp_over_stream '1'
  option heartbeat '10s'
  option max_concurrent_streams '50'
  option tls_server_name 'example.com'

config outbound 'anytls_node'
  option tag 'AnyTLS'
  option type 'anytls'
  option server '192.0.2.8'
  option server_port '443'
  option password 'placeholder-password'
  option idle_session_check_interval '30s'
  option idle_session_timeout '60s'
  option min_idle_session '2'
  option client_metadata 'custom'
  option tls_server_name 'example.com'

config outbound 'snell4'
  option tag 'Snell v4'
  option type 'snell'
  option server '192.0.2.13'
  option server_port '443'
  option version '4'
  option psk 'placeholder-psk'
  option reuse '1'
  option obfs_mode 'http'
  option obfs_host 'bing.com'

config outbound 'snell6'
  option tag 'Snell v6'
  option type 'snell'
  option server '192.0.2.9'
  option server_port '443'
  option version '6'
  option psk 'placeholder-psk-0123'
  option userkey 'placeholder-userkey'
  option mode 'unshaped'

config outbound 'ssh_node'
  option tag 'SSH'
  option type 'ssh'
  option server '192.0.2.10'
  option server_port '22'
  option user 'root'
  option password 'placeholder-password'
  list host_key_algorithms 'ssh-ed25519'
  option client_version 'SSH-2.0-OpenSSH_9.6'
  list cipher 'aes128-gcm@openssh.com'
  list mac 'hmac-sha2-256-etm@openssh.com'
  list kex_algorithm 'curve25519-sha256'

config outbound 'http_proxy'
  option tag 'HTTP proxy'
  option type 'http'
  option server '192.0.2.11'
  option server_port '8080'
  list headers 'X-Test: a'
