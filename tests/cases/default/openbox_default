config log 'log'
  option level 'warn'
  option timestamp '1'

config dns 'dns'
  option final 'cloudflare'
  option strategy 'ipv4_only'
  option optimistic '1'

config dns_server 'local'
  option tag 'local'
  option type 'local'

config dns_server 'alidns'
  option tag 'alidns'
  option type 'quic'
  option server '223.5.5.5'

config dns_server 'cloudflare'
  option tag 'cloudflare'
  option type 'https'
  option server '1.1.1.1'
  option detour 'proxy'

config dns_server 'fakeip'
  option tag 'fakeip'
  option type 'fakeip'
  option inet4_range '198.18.0.0/15'
  option inet6_range '2001:2::/48'

config dns_rule
  list domain_suffix 'lan'
  list domain_suffix '10.in-addr.arpa'
  list domain_suffix '168.192.in-addr.arpa'
  list domain_regex '\.(1[6-9]|2[0-9]|3[01])\.172\.in-addr\.arpa$'
  option server 'local'

config dns_rule
  option action 'evaluate'
  option server 'alidns'
  option timeout '2s'

config dns_rule
  option match_response '1'
  list rule_set 'cn_ip'
  option action 'respond'

config dns_rule 'foreign'
  option match_response '1'
  option response_rcode 'NOERROR'
  option ip_accept_any '1'
  list query_type 'A'
  list query_type 'AAAA'
  option server 'fakeip'
  option rewrite_ttl '1'

config dns_rule
  option match_response '1'
  option response_rcode 'NOERROR'
  option action 'respond'

config dns_rule
  option match_response '1'
  option response_rcode 'NXDOMAIN'
  option action 'respond'

config dns_rule 'fallback'
  list query_type 'A'
  list query_type 'AAAA'
  option server 'fakeip'
  option rewrite_ttl '1'

config ntp 'ntp'
  option enabled '0'
  option server 'ntp.aliyun.com'
  option server_port '123'
  option interval '30m'

config http_client 'proxy_client'
  option tag 'HTTP Proxy'
  option dial_fields '{"detour": "Proxy"}'

config route 'route'
  option final 'final'
  option default_domain_resolver 'alidns'
  option find_neighbor '1'

config rule_set 'cn_ip'
  option tag 'cn-mainland-ip'
  option type 'local'
  option format 'binary'
  option path '/usr/share/openbox/rule-set/cn-mainland-ip.srs'

config outbound 'direct'
  option tag 'Direct'
  option type 'direct'
  option hidden '1'

config outbound 'proxy'
  option tag 'Proxy'
  option type 'selector'
  list outbounds 'direct'

config outbound 'final'
  option tag 'Final'
  option type 'selector'
  list outbounds 'proxy'
  list outbounds 'direct'

config outbound 'global'
  option tag 'Global'
  option type 'selector'
  option hidden '1'

config route_rule
  option action 'sniff'
  option hidden '1'

config route_rule
  list protocol 'dns'
  option action 'hijack-dns'
  option hidden '1'

config route_rule
  option ip_is_private '1'
  option outbound 'direct'
  option hidden '1'

config route_rule
  option clash_mode 'Direct'
  option outbound 'direct'
  option hidden '1'

config route_rule
  option clash_mode 'Global'
  option outbound 'global'
  option hidden '1'

config route_rule
  list port '853'
  option action 'reject'

config route_rule
  list protocol 'quic'
  option action 'reject'

config route_rule
  list rule_set 'cn_ip'
  option outbound 'direct'
