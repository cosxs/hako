{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "final": "remote",
    "strategy": "ipv4_only",
    "optimistic": true,
    "servers": [
      {
        "type": "local",
        "tag": "local"
      },
      {
        "type": "udp",
        "tag": "alidns",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "2001:2::/48"
      },
      {
        "type": "https",
        "tag": "remote",
        "detour": "Proxy",
        "server": "1.1.1.1"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "lan",
          "10.in-addr.arpa",
          "168.192.in-addr.arpa"
        ],
        "domain_regex": [
          "\\.(1[6-9]|2[0-9]|3[01])\\.172\\.in-addr\\.arpa$"
        ],
        "server": "local"
      },
      {
        "action": "evaluate",
        "server": "alidns",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": [
          "cn-mainland-ip"
        ],
        "action": "respond"
      },
      {
        "match_response": true,
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      },
      {
        "match_response": true,
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": true,
        "response_rcode": "NXDOMAIN",
        "action": "respond"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ]
  },
  "ntp": {
    "enabled": false,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "hako-tun",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "auto_redirect": true,
      "route_exclude_address": [
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.168.0.0/16",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "::1/128",
        "fd00::/8",
        "fe80::/10",
        "ff00::/8"
      ],
      "route_exclude_address_set": [
        "cn-mainland-ip"
      ]
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 1053
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "Direct"
    },
    {
      "type": "shadowsocks",
      "tag": "机场 A · HK 01",
      "server": "hk.example.com",
      "server_port": 8388,
      "method": "aes-128-gcm",
      "password": "placeholder-password"
    },
    {
      "type": "shadowsocks",
      "tag": "机场 A · JP 02",
      "server": "jp.example.com",
      "server_port": 8388,
      "method": "aes-128-gcm",
      "password": "placeholder-password"
    },
    {
      "type": "shadowsocks",
      "tag": "机场 A · Relay",
      "server": "relay.example.com",
      "server_port": 8388,
      "method": "aes-128-gcm",
      "password": "placeholder-password",
      "detour": "机场 A · HK 01"
    },
    {
      "type": "shadowsocks",
      "tag": "B · JP 02",
      "server": "jp2.example.net",
      "server_port": 8388,
      "method": "2022-blake3-aes-128-gcm",
      "password": "bXlwYXNzd29yZDEyMzQ1Ng=="
    },
    {
      "type": "shadowsocks",
      "tag": "B · US 03",
      "server": "us3.example.net",
      "server_port": 8388,
      "method": "2022-blake3-aes-128-gcm",
      "password": "bXlwYXNzd29yZDEyMzQ1Ng=="
    },
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "Auto",
        "机场 A",
        "B · US 03",
        "Direct"
      ]
    },
    {
      "type": "urltest",
      "tag": "Auto",
      "outbounds": [
        "机场 B"
      ]
    },
    {
      "type": "selector",
      "tag": "B · Direct",
      "outbounds": [
        "Direct"
      ]
    },
    {
      "type": "urltest",
      "tag": "Japan",
      "outbounds": [
        "机场 A · JP 02",
        "B · JP 02"
      ]
    },
    {
      "type": "selector",
      "tag": "Broken filter",
      "outbounds": [
        "Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "Global",
      "outbounds": [
        "Direct",
        "Proxy",
        "Auto",
        "B · Direct",
        "Japan",
        "Broken filter",
        "机场 A",
        "机场 B"
      ]
    },
    {
      "type": "selector",
      "tag": "机场 A",
      "outbounds": [
        "机场 A · HK 01",
        "机场 A · JP 02",
        "机场 A · Relay"
      ]
    },
    {
      "type": "urltest",
      "tag": "机场 B",
      "outbounds": [
        "B · JP 02",
        "B · US 03"
      ]
    }
  ],
  "http_clients": [
  ],
  "route": {
    "final": "Proxy",
    "default_domain_resolver": "alidns",
    "find_neighbor": true,
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "Direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "Global"
      },
      {
        "port": [
          853
        ],
        "action": "reject"
      },
      {
        "protocol": [
          "quic"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "cn-mainland-ip"
        ],
        "outbound": "Direct"
      },
      {
        "domain_suffix": [
          "netflix.com"
        ],
        "outbound": "机场 A"
      }
    ],
    "rule_set": [
      {
        "tag": "cn-mainland-ip",
        "type": "local",
        "format": "binary",
        "path": "/usr/share/hako/rule-set/cn-mainland-ip.srs"
      }
    ]
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "path": "/etc/hako/cache.db",
      "store_fakeip": true
    }
  }
}
